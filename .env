# Copy this file:
#   - direct run:  cp .env.example backend/.env
#   - docker:      cp .env.example .env
# Then fill in the required values below.

# ---- Required ----

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID(s) from @userinfobot. Comma-separated for
# multiple admins. Only these IDs can use /connect, /connectwallet, /setrule,
# /enable, /disable, /paper, /live, and manual position close.
TELEGRAM_ADMIN_IDS=

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt the Anoncoin API key and every connected wallet's private
# key at rest. Rotating this means every admin has to reconnect via
# /connect and /connectwallet afterwards.
SECRET_ENCRYPTION_KEY=

# ---- Optional: Anoncoin ----
# Not required for real launch detection or on-chain trading - those go
# through the on-chain watcher + Meteora/Jupiter regardless of this. Only
# needed once Anoncoin ships their discovery/trade endpoints, or if you use
# Top Holders today. Generate at anoncoin.it -> profile -> API Key, or set
# later from Telegram with /connect instead of putting it here.
# ANONCOIN_API_KEY=
# ANONCOIN_BASE_URL=https://api.anoncoin.it
# ANONCOIN_TRADE_ENDPOINT=

# ---- Optional: Solscan ----
# Enrichment only (holders/meta) - detection does not depend on this.
# SOLSCAN_API_KEY=
# SOLSCAN_BASE_URL=https://pro-api.solscan.io/v2.0

# ---- Creator watchlist ----
# Comma-separated wallet addresses to watch on-chain for new mints. Defaults
# to Anoncoin.it's own pool-creation relayer wallet (confirmed: it fires
# InitializeVirtualPoolWithToken2022 on Meteora's DBC program for every new
# Anoncoin token). Add more addresses to also watch specific creators.
# CREATOR_WATCHLIST=7AbRGzM3NBvvUXi7j1Mga2SraTfjpPBMzGpyHcXSzV3v

# ---- Trading ----
# Only used the very first time the bot ever starts (creates bot_state row).
# After that, use /paper and /live in Telegram - they persist to the
# database and this value is not read again.
# TRADING_MODE=paper
# PAPER_STARTING_BALANCE_SOL=10.0
# QUALIFY_SCORE_THRESHOLD=50.0

# Demo only. Leave OFF (false) for normal use - see scanners/scanner.py.
# When on, adds 0-2 clearly-labelled [SIMULATED] tokens per scan cycle on
# top of real on-chain detections; it never places live trades either way.
# ENABLE_MOCK_FEED=false

# ---- On-chain execution ----
# The free public RPC can rate-limit under bursty activity. If you see
# frequent get_transaction_failed warnings, switch to a dedicated provider
# (Helius/QuickNode/Triton) for more reliable detection and execution.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
# JUPITER_PRICE_URL=https://lite-api.jup.ag/price/v3
# DEFAULT_SLIPPAGE_BPS=300

# ---- Timers ----
# SCAN_INTERVAL_SECONDS=30
# POSITION_CHECK_INTERVAL_SECONDS=20
# DAILY_SUMMARY_HOUR_UTC=23

# ---- Misc ----
# DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# LOG_LEVEL=INFO
